{
  "openapi": "3.1.0",
  "info": {
    "title": "hivemind local API",
    "description": "The loopback API on 127.0.0.1:8401. No authentication: reachability is the authorization, and the listener refuses to bind anywhere else.\n\n## Problem types\n\nErrors are RFC 9457 `application/problem+json`. The `type` member is stable:\n\n- `/problems/message-not-found` — No such message (404)\n- `/problems/invalid-message` — Message is not acceptable (422)\n- `/problems/no-recipients` — Message has no recipients (422)\n- `/problems/not-paired` — Not paired (403)\n- `/problems/identity-mismatch` — Identity does not match the certificate (400)\n- `/problems/bad-signature` — Signature does not verify (400)\n- `/problems/peer-unreachable` — Peer could not be reached (502)\n- `/problems/blob-not-found` — No such attachment (404)\n- `/problems/blob-too-large` — Attachment is too large (413)\n- `/problems/unsafe-attachment-name` — Attachment name is not a file name (422)\n- `/problems/internal` — Internal error (500)",
    "contact": {
      "name": "The hivemind contributors"
    },
    "license": {
      "name": "Apache-2.0 OR MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/events": {
      "get": {
        "tags": [
          "local"
        ],
        "summary": "The SSE stream (SPEC §7.1).",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "text/event-stream of message.* events"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "local"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages": {
      "get": {
        "tags": [
          "local"
        ],
        "operationId": "list_messages",
        "parameters": [
          {
            "name": "box",
            "in": "path",
            "description": "Restrict to one mailbox: `new`, `cur`, `out` or `sent`.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "thread",
            "in": "path",
            "description": "Restrict to one thread.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "from",
            "in": "path",
            "description": "Restrict to one sender, by node id.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "unread",
            "in": "path",
            "description": "Only unread messages.",
            "required": true,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "q",
            "in": "path",
            "description": "Full-text search over subject and body.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "How many to return.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageSummary"
                  }
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "local"
        ],
        "operationId": "send_message",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}": {
      "get": {
        "tags": [
          "local"
        ],
        "operationId": "get_message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Message id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
