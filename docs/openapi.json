        "operationId": "trust_network",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeerSummary"
                  }
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/peers/{id}": {
      "delete": {
        "tags": [
          "peers"
        ],
        "operationId": "remove_peer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The peer's full or short id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Forgotten"
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/peers/{id}/pair": {
      "post": {
        "tags": [
          "peers"
        ],
        "operationId": "confirm_pair",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The peer's full or short id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeerSummary"
                }
              }
            }
