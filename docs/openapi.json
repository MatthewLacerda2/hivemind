        "responses": {
          "204": {
            "description": "Marked read"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}/reply": {
      "post": {
        "tags": [
