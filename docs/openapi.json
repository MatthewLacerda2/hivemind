  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "description": "What a send returns (SPEC §8: accepted, not delivered).",
        "required": [
          "id",
          "thread_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The new message's id."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          }
        }
      },
      "Attachment": {
        "type": "object",
        "description": "One attachment, as the local API describes it (SPEC §7.1).",
        "required": [
          "name",
          "size",
          "sha256",
          "mime",
          "inline",
          "cached"
        ],
        "properties": {
          "cached": {
            "type": "boolean",
            "description": "Whether the bytes are already on this machine. `false` means the first\nread of it will go to the sender."
          },
          "inline": {
            "type": "boolean",
            "description": "Whether it travelled with the message or is fetched on demand."
          },
          "mime": {
            "type": "string",
            "description": "What the sender says it is. Advisory (SPEC §4.1)."
          },
          "name": {
            "type": "string",
            "description": "The name to save it as. Checked on arrival, never a path (SPEC §6.3)."
          },
          "sha256": {
            "type": "string",
            "description": "Its content address, and the `sha` in the attachment URL."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Its size in bytes.",
            "minimum": 0
          }
        }
      },
      "CreateGroup": {
        "type": "object",
        "description": "Make a new group.",
        "properties": {
          "replace": {
            "type": "boolean",
            "description": "Leave the group this node is in for a new one. This is how a group\nrotates its key; without it, a node already in a group is refused."
          }
        }
      },
      "CreatedGroup": {
        "type": "object",
        "description": "A new group's code, shown once.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "What every other machine pastes into `hivemind pair`.",
            "example": "hm-aaaq-eaye-auda-ocaj-bifq-ydio-b4"
          }
        }
      },
      "GroupSummary": {
        "type": "object",
        "description": "Which group this node is in. Never the key.",
        "required": [
          "in_group",
          "members"
        ],
        "properties": {
          "in_group": {
            "type": "boolean",
            "description": "Whether this node is in a group at all."
          },
          "joined_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it joined or created it."
          },
          "members": {
            "type": "integer",
            "description": "How many other nodes have proved the key to this one.",
            "minimum": 0
          }
        }
      },
      "JoinGroup": {
        "type": "object",
        "description": "Join the group a code belongs to.",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The code, as pasted. Case, the `hm-` prefix and hyphens do not matter.",
            "example": "hm-aaaq-eaye-auda-ocaj-bifq-ydio-b4"
          },
          "replace": {
            "type": "boolean",
            "description": "Leave a different group this node is already in."
          }
        }
      },
      "JoinRequest": {
        "type": "object",
        "description": "Where to look for a node discovery cannot find.",
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "description": "A hostname or address, with an optional `:port`.",
            "example": "laptop.local:8400"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "Who this node is (SPEC §7.1).",
        "required": [
          "id",
          "short_id",
          "version",
          "unread",
          "name",
          "peer_port",
          "peers",
          "in_group",
          "seen",
          "outbox"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "This node's fingerprint, in its display form.",
            "example": "hm1:w2mq-xor2-seiv-lghq-ybqb-36iv-i24o-n5vk-dpww-736k-eici-imu3-bnwq"
          },
          "in_group": {
            "type": "boolean",
            "description": "Whether this node is in a group at all (SPEC §6.2). Without one it\ncan reach nobody."
          },
          "name": {
            "type": "string",
            "description": "The display name peers see."
          },
          "outbox": {
            "type": "integer",
            "description": "How many messages are still on their way out.",
            "minimum": 0
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "description": "The human who owns this machine, if they said."
          },
          "peer_port": {
            "type": "integer",
            "format": "int32",
            "description": "The port the peer listener is on.",
            "minimum": 0
          },
          "peers": {
            "type": "integer",
            "description": "How many peers are paired.",
            "minimum": 0
          },
          "seen": {
            "type": "integer",
            "description": "How many nodes have been seen that are not in this node's group.",
            "minimum": 0
          },
          "short_id": {
            "type": "string",
            "description": "The short form people compare by eye.",
            "example": "w2mqxor2"
          },
          "unread": {
            "type": "integer",
            "format": "int64",
            "description": "How many unread messages there are.",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "description": "The running version."
          }
        }
      },
      "MessageBody": {
        "type": "object",
        "description": "A whole message.",
        "required": [
          "id",
          "thread_id",
          "from",
          "subject",
          "body",
          "kind",
          "sender_kind",
          "sent_at",
          "mailbox",
          "attachments"
        ],
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            },
            "description": "The files that came with it."
          },
          "body": {
            "type": "string",
            "description": "Its body, as markdown."
          },
          "from": {
            "type": "string",
            "description": "Who sent it."
          },
          "id": {
            "type": "string",
            "description": "The message id."
          },
          "in_reply_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "What it replies to, if anything."
          },
          "kind": {
            "type": "string",
            "description": "`message`, `task` or `notification`."
          },
          "mailbox": {
            "type": "string",
            "description": "Which mailbox it is in."
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When this node received it, if it did."
          },
          "sender_kind": {
            "type": "string",
            "description": "`human` if a person typed it, `agent` if a Claude sent it."
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was sent."
          },
          "subject": {
            "type": "string",
            "description": "Its subject."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          }
        }
      },
      "MessageSummary": {
        "type": "object",
        "description": "One row of a listing (SPEC §9.1).",
        "required": [
          "id",
          "thread_id",
          "from",
          "subject",
          "kind",
          "sender_kind",
          "sent_at",
          "mailbox",
          "unread",
          "attachment_names"
        ],
        "properties": {
          "attachment_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names of its attachments."
          },
          "from": {
            "type": "string",
            "description": "Who sent it."
          },
          "id": {
            "type": "string",
            "description": "The message id."
          },
          "kind": {
            "type": "string",
            "description": "`message`, `task` or `notification`."
          },
          "mailbox": {
            "type": "string",
            "description": "Which mailbox it is in."
          },
          "sender_kind": {
            "type": "string",
            "description": "`human` if a person typed it, `agent` if a Claude sent it."
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was sent."
          },
          "subject": {
            "type": "string",
            "description": "Its subject."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          },
          "unread": {
            "type": "boolean",
            "description": "Whether it is still unread."
          }
        }
      },
      "PeerSummary": {
        "type": "object",
        "description": "A peer, paired or merely seen (SPEC §7.1).",
        "required": [
          "id",
          "short_id",
          "name",
          "addrs",
          "paired",
          "online",
          "sessions"
        ],
        "properties": {
          "addrs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where it can be reached, best guess first."
          },
          "id": {
            "type": "string",
            "description": "Its fingerprint, in display form."
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ],
            "description": "When we last heard from it."
          },
          "name": {
            "type": "string",
            "description": "What it calls itself. Unverified (ADR 0003)."
          },
          "online": {
            "type": "boolean",
            "description": "Whether it said hello within the last two presence intervals\n(SPEC §5.5). Always `false` for a node only seen."
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who owns it, if it said. Also unverified."
          },
          "paired": {
            "type": "boolean",
            "description": "Whether it has proved the group key, so mail flows (SPEC §6.2), or was\nonly seen."
          },
          "paired_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it proved the key to this node. `null` for a node only seen."
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What it is working on: one label per open Claude Code session\n(SPEC §9.3). Empty until #52 fills the register."
          },
          "short_id": {
            "type": "string",
            "description": "The short form people compare by eye."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem document.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong with *this* request."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "A short summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "A relative URI reference identifying the problem type, stable across\nreleases: `/problems/<slug>`.",
            "example": "/problems/message-not-found"
          }
        }
      },
      "Refreshed": {
        "type": "object",
        "description": "What a discovery run turned up.",
        "required": [
          "found"
        ],
        "properties": {
          "found": {
            "type": "integer",
            "description": "How many nodes answered, members or not.",
            "minimum": 0
          }
        }
      },
      "RegisterSession": {
        "type": "object",
        "description": "What a registration says about itself.",
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "What it is working on. The hook sends the basename of its `cwd`."
          }
        }
      },
      "Registered": {
        "type": "object",
        "description": "What a registration answers.",
        "required": [
          "open"
        ],
        "properties": {
          "open": {
            "type": "integer",
            "description": "How many sessions are open now, this one included.",
            "minimum": 0
          }
        }
      },
      "ReplyRequest": {
        "type": "object",
        "description": "What to say in a reply.",
        "required": [
          "body"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Absolute paths to local files to send with it. The API is loopback\nonly, so these are paths on this machine (SPEC §7.1)."
          },
          "body": {
            "type": "string",
            "description": "The body, as markdown."
          }
        }
      },
      "SendRequest": {
        "type": "object",
        "description": "What to send.\n\nThere is deliberately no `sender_kind`: it is decided by which entrypoint\nthe request arrived through, and a caller offering one is ignored\n(SPEC §4.1).",
        "required": [
          "to",
          "subject",
          "body"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Absolute paths to local files to send with it. The API is loopback\nonly, so these are paths on this machine (SPEC §7.1)."
          },
          "body": {
            "type": "string",
            "description": "The body, as markdown."
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "`message`, `task` or `notification`. Defaults to `message`."
          },
          "subject": {
            "type": "string",
            "description": "The subject, at most 200 characters."
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Recipients: a node id, an owner name, or `everyone`.",
            "example": [
              "everyone"
            ]
          }
        }
      },
      "SessionSummary": {
        "type": "object",
        "description": "One session open on this machine.",
        "required": [
          "label",
          "last_seen"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "What it is working on — the basename of its working directory."
          },
          "last_seen": {
            "type": "string",
            "description": "When it last showed a sign of life, RFC 3339."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "messages",
      "description": "Reading and sending mail"
    },
    {
      "name": "peers",
      "description": "Members, nodes seen, and where they are"
    },
    {
      "name": "group",
      "description": "The group this node is in (SPEC §6.2)"
    },
    {
      "name": "node",
      "description": "This node"
    },
    {
      "name": "sessions",
      "description": "Claude Code sessions open on this machine (SPEC §9.3)"
    }
  ]
}
