          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "local"
        ],
        "summary": "Liveness. Deliberately says nothing about the network.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The daemon is up"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "type": "object",
        "description": "What a send returns (SPEC §8: accepted, not delivered).",
        "required": [
          "id",
          "thread_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The new message's id."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          }
        }
      },
      "JoinRequest": {
        "type": "object",
        "description": "Where to look for a node to introduce ourselves to.",
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "description": "A hostname or address, with an optional `:port`.",
            "example": "laptop.local:8400"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "Who this node is (SPEC §7.1).",
        "required": [
          "id",
          "short_id",
          "version",
          "unread"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "This node's fingerprint, in its display form.",
            "example": "hm1:w2mq-xor2-seiv-lghq-ybqb-36iv-i24o-n5vk-dpww-736k-eici-imu3-bnwq"
          },
          "short_id": {
            "type": "string",
            "description": "The short form people compare by eye.",
            "example": "w2mqxor2"
          },
          "unread": {
            "type": "integer",
            "format": "int64",
            "description": "How many unread messages there are.",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "description": "The running version."
          }
        }
      },
      "MessageBody": {
        "type": "object",
        "description": "A whole message.",
        "required": [
          "id",
          "thread_id",
          "from",
          "subject",
          "body",
          "kind",
          "sender_kind",
          "sent_at",
          "mailbox"
        ],
        "properties": {
          "body": {
            "type": "string",
            "description": "Its body, as markdown."
          },
          "from": {
            "type": "string",
            "description": "Who sent it."
          },
          "id": {
            "type": "string",
            "description": "The message id."
          },
          "in_reply_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "What it replies to, if anything."
          },
          "kind": {
            "type": "string",
            "description": "`message`, `task` or `notification`."
          },
          "mailbox": {
            "type": "string",
            "description": "Which mailbox it is in."
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When this node received it, if it did."
          },
          "sender_kind": {
            "type": "string",
            "description": "`human` if a person typed it, `agent` if a Claude sent it."
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was sent."
          },
          "subject": {
            "type": "string",
            "description": "Its subject."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          }
        }
      },
      "MessageSummary": {
        "type": "object",
        "description": "One row of a listing (SPEC §9.1).",
        "required": [
          "id",
          "thread_id",
          "from",
          "subject",
          "kind",
          "sender_kind",
          "sent_at",
          "mailbox",
          "unread",
          "attachment_names"
        ],
        "properties": {
          "attachment_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names of its attachments."
          },
          "from": {
            "type": "string",
            "description": "Who sent it."
          },
          "id": {
            "type": "string",
            "description": "The message id."
          },
          "kind": {
            "type": "string",
            "description": "`message`, `task` or `notification`."
          },
          "mailbox": {
            "type": "string",
            "description": "Which mailbox it is in."
          },
          "sender_kind": {
            "type": "string",
            "description": "`human` if a person typed it, `agent` if a Claude sent it."
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was sent."
          },
          "subject": {
            "type": "string",
            "description": "Its subject."
          },
          "thread_id": {
            "type": "string",
            "description": "The thread it belongs to."
          },
          "unread": {
            "type": "boolean",
            "description": "Whether it is still unread."
          }
        }
      },
      "PeerSummary": {
        "type": "object",
        "description": "A peer, paired or merely seen (SPEC §7.1).",
        "required": [
          "id",
          "short_id",
          "name",
          "addrs",
          "paired"
        ],
        "properties": {
          "addrs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Where it can be reached, best guess first."
          },
          "id": {
            "type": "string",
            "description": "Its fingerprint, in display form."
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ],
            "description": "When we last heard from it."
          },
          "name": {
            "type": "string",
            "description": "What it calls itself. Unverified (ADR 0003)."
          },
          "owner": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who owns it, if it said. Also unverified."
          },
          "paired": {
            "type": "boolean",
            "description": "Whether mail will actually flow, or it is still waiting on a\nconfirmation from one side or the other (SPEC §6.2)."
          },
          "paired_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When this side confirmed. `null` while still pending."
          },
          "short_id": {
            "type": "string",
            "description": "The short form people compare by eye."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem document.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "What went wrong with *this* request."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "A short summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "A relative URI reference identifying the problem type, stable across\nreleases: `/problems/<slug>`.",
            "example": "/problems/message-not-found"
          }
        }
      },
      "Refreshed": {
        "type": "object",
        "description": "What a discovery run turned up.",
        "required": [
          "found"
        ],
        "properties": {
          "found": {
            "type": "integer",
            "description": "How many nodes answered and were greeted.",
            "minimum": 0
          }
        }
      },
      "ReplyRequest": {
        "type": "object",
        "description": "What to say in a reply.",
        "required": [
          "body"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Absolute paths to local files to send with it. The API is loopback\nonly, so these are paths on this machine (SPEC §7.1)."
          },
          "body": {
            "type": "string",
            "description": "The body, as markdown."
          }
        }
      },
      "SendRequest": {
        "type": "object",
        "description": "What to send.\n\nThere is deliberately no `sender_kind`: it is decided by which entrypoint\nthe request arrived through, and a caller offering one is ignored\n(SPEC §4.1).",
        "required": [
          "to",
          "subject",
          "body"
        ],
        "properties": {
          "attachments": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Absolute paths to local files to send with it. The API is loopback\nonly, so these are paths on this machine (SPEC §7.1)."
          },
          "body": {
            "type": "string",
            "description": "The body, as markdown."
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "`message`, `task` or `notification`. Defaults to `message`."
          },
          "subject": {
            "type": "string",
            "description": "The subject, at most 200 characters."
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Recipients: a node id, an owner name, or `everyone`.",
            "example": [
              "everyone"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "messages",
      "description": "Reading and sending mail"
    },
    {
      "name": "peers",
      "description": "Pairing and the address book"
    },
    {
      "name": "node",
      "description": "This node"
    }
  ]
}
