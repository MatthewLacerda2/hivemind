      }
    },
    "/api/v1/threads/{thread_id}": {
      "get": {
        "tags": [
          "local"
        ],
        "operationId": "get_thread",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "description": "Thread id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
