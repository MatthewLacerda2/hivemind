    "/api/v1/sessions/{id}": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Register a session, or renew one already known (SPEC §9.3).",
        "description": "One call for both, because the hook that renews cannot know whether the\ndaemon has heard of it — a daemon restarted mid-conversation missed the\n`SessionStart`, and the next prompt is the first it learns of a session\nthat is plainly alive.",
        "operationId": "register_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The session id Claude Code gives its hooks",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
