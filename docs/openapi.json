    "/api/v1/messages": {
      "get": {
        "tags": [
          "local"
        ],
        "operationId": "list_messages",
        "parameters": [
          {
            "name": "box",
            "in": "path",
            "description": "Restrict to one mailbox: `new`, `cur`, `out` or `sent`.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "thread",
            "in": "path",
            "description": "Restrict to one thread.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "from",
            "in": "path",
            "description": "Restrict to one sender, by node id.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "unread",
            "in": "path",
            "description": "Only unread messages.",
            "required": true,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "q",
            "in": "path",
            "description": "Full-text search over subject and body.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "How many to return.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "cursor",
            "in": "path",
            "description": "Continue after this row, from a previous page (SPEC §7.1).\n\nBuild it from the last summary already received: `<sent_at in\nmilliseconds>:<id>`. Keyset rather than offset, so a message arriving\nwhile somebody pages through their inbox cannot make a row appear\ntwice or not at all.",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MessageSummary"
                  }
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
