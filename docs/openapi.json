                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "sessions"
        ],
        "summary": "Close a session (SPEC §9.3).",
        "description": "`204` whether or not there was one. `SessionEnd` is a courtesy and expiry\nis what makes the list true, so \"there was nothing to close\" is the\ncaller's request already satisfied rather than a mistake to report.",
        "operationId": "end_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The session id Claude Code gives its hooks",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Closed, or there was nothing to close"
          }
        }
      }
    },
